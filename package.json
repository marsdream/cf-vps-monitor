{
  "name": "cf-vps-monitor-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend",
    "worker"
  ],
  "scripts": {
    "postinstall": "node scripts/install-wrangler-wrapper.mjs",
    "lint": "npm --prefix frontend run lint && npm --prefix worker run lint",
    "build:migrations": "node scripts/generate-migrations.mjs",
    "build": "npm --prefix frontend run build && npm --prefix worker run build",
    "test:js": "node --test",
    "test:go": "cd agent && go test ./...",
    "test": "npm run test:js && npm run test:go",
    "security:check": "node scripts/security-check.mjs",
    "verify": "npm run lint && npm run build && npm test && npm run security:check",
    "verify:cloudflare": "node scripts/deploy-cloudflare.mjs --dry-run --outdir worker/.tmp/wrangler-dry-run --metafile worker/.tmp/wrangler-dry-run/metafile.json",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "dev:worker": "npm --prefix worker run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "cloudflare": {
    "bindings": {
      "SUPABASE_URL": {
        "description": "Supabase \u9879\u76ee\u7684 Project URL\uff0c\u4f8b\u5982 `https://PROJECT_REF.supabase.co`\u3002\u5728 Supabase Project Settings -> API \u91cc\u590d\u5236\u3002"
      },
      "SUPABASE_SECRET_KEY": {
        "description": "Supabase Secret key\uff0c\u901a\u5e38\u4ee5 sb_secret_ \u5f00\u5934\u3002\u4e0d\u8981\u586b Publishable key \u6216 anon key\u3002"
      },
      "JWT_SECRET": {
        "description": "\u540e\u53f0\u767b\u5f55\u4f1a\u8bdd\u7b7e\u540d\u5bc6\u94a5\u3002\u5efa\u8bae\u4f7f\u7528\u81f3\u5c11 32 \u4e2a\u5b57\u7b26\u7684\u968f\u673a\u5b57\u7b26\u4e32\u3002"
      }
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "esbuild": "0.28.1",
    "miniflare": "4.20260730.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4",
      "undici": "^7.30.1"
    }
  }
}